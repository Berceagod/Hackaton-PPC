          "expr": "sum(rate(filegrid_requests_total{outcome=~\"server_error|integrity_error\",operation!=\"drain\"}[$__rate_interval])) / sum(rate(filegrid_requests_total{operation!=\"drain\"}[$__rate_interval]))",
