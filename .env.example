# Copy to .env — or just run ./start.sh, which generates .env with random secrets
# the first time it is run. NEVER commit .env.

# --- PostgreSQL (metadata) ---
POSTGRES_META_PASSWORD=

# --- PostgreSQL (blob storage backend, separate instance) ---
POSTGRES_BLOB_PASSWORD=

# --- FTP storage backend ---
FTP_USER=
FTP_PASSWORD=

# --- MinIO (S3) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Meter simulator volume (optional; defaults shown) ---
# SIM_BASE_RATE=10          # readings/second on a normal day
# SIM_STORM_MULTIPLIER=10   # storm mode = BASE_RATE x this
# SIM_METER_COUNT=1000
# SIM_DUPLICATE_RATIO=0.05  # share of readings re-sent on purpose
# SIM_ANOMALY_RATIO=0.02
# SIM_START_MODE=normal     # normal | storm

# --- Backend auth ---
JWT_SECRET=
SIMULATOR_TOKEN=
# UI accounts: dispecer@ppc.ro / admin@ppc.ro (emails fixed by the frontend).
# start.sh / start.ps1 generate random passwords and print them when the stack is up.
DISPECER_PASSWORD=
ADMIN_PASSWORD=

# --- Encryption at rest (ADR-0011) ---
# 64 hex characters (32 bytes), generated by start.sh. BACK IT UP: without it the
# encrypted documents (connection_docs) cannot be decrypted. Never commit it.
FILEGRID_MASTER_KEY=

# --- Isolation / resilience tuning (optional; defaults shown, ADR-0013) ---
# UVICORN_WORKERS=4          # backend processes per container
# DB_POOL=6                  # metadata connections per worker
# METER_DB_POOL=4            # meter-reading connections per worker (bulkhead)
# BULKHEAD_HIGH=64           # concurrent requests per category and worker, by policy priority
# BULKHEAD_NORMAL=32
# BULKHEAD_LOW=8
# BREAKER_THRESHOLD=3        # storage failures before failing fast
# BREAKER_COOLDOWN_SECONDS=5
# UPLOAD_TTL_HOURS=24        # abandoned chunked uploads are purged after this

# ---- slice H (observability) settings (commented defaults): add directly below this line ----
# GRAFANA_ADMIN_PASSWORD=          # generated by start.sh; login for https://localhost/grafana/ (user: admin)
# LOKI_COMPOSE_PROJECT=hackaton-ppc  # compose project whose container logs go to Loki (set by start.sh)
# PROMETHEUS_SAMPLE_SECONDS=10     # how often the outbox / breaker / PII / upload gauges are refreshed
# PROMETHEUS_UPLOAD_STALL_SECONDS=300  # a chunked upload with no chunk for this long counts as stalled

# ---- slice I (analytics) settings (commented defaults): add directly below this line ----
# PROMETHEUS_URL=http://prometheus:9090   # slice H; /analytics/summary still answers if this is down
# ANALYTICS_RANGE=5m                      # PromQL window for the live latency table
# ANALYTICS_TIMEOUT_SECONDS=2
# BENCHMARK_SAMPLES=5                     # ingests per category per storage in scripts/benchmark/run.sh
# BENCHMARK_OUTAGE_KB=64
# BENCHMARK_DRONE_KB=1024
# SCENARIO_METERS=12                      # normal-day meter readings; peak-day and storm use 10x
# SCENARIO_OUTAGES=3

# ---- slice J (scale-out) settings (commented defaults): add directly below this line ----

# ---- background scrubber (improvements.md): re-verifies stored files on its own ----
# SCRUB_ENABLED=true
# SCRUB_INTERVAL_SECONDS=30     # pause between batches (lower it to see the scrubber work in a demo)
# SCRUB_BATCH=5                 # files checked per batch, per worker
# SCRUB_RECHECK_SECONDS=3600    # a file is re-checked at most this often
# SCRUB_MAX_BYTES=67108864      # bigger files are skipped by the background job (64 MB)
# SCRUB_CATEGORIES=outage_records,connection_docs,drone_videos   # meter readings are not scrubbed

# ---- accounts and login hardening (improvements.md 2.5) ----
# AUDITOR_PASSWORD=             # generated by start.sh; the auditor reads audit trails, never file content
# LOGIN_MAX_FAILURES=5          # then the account is locked for 30 s, doubling each further failure
# LOGIN_LOCK_BASE_SECONDS=30
# LOGIN_LOCK_MAX_SECONDS=900

# ---- storage canary (improvements.md 2.8): a tiny put/get/verify/delete on every storage ----
# CANARY_ENABLED=true
# CANARY_INTERVAL_SECONDS=60

# ---- chaos console (improvements.md 2.1): break things on purpose, for the demo ----
# CHAOS_ENABLED=false           # true = admin can simulate a storage outage / slow storage / bad network
# CHAOS_MAX_SECONDS=600         # every fault expires by itself after at most this long
# CHAOS_DEFAULT_SECONDS=60
